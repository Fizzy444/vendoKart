# ==============================================================================
# vendoKart Backend Configuration (.env)
# ==============================================================================

# Application Environment
APP_ENV=development
APP_NAME=artisan-commerce
SECRET_KEY=dev-super-secret-key-change-in-production-1234567890
API_V1_STR=/api/v1
PORT=8000

# PostgreSQL Database
POSTGRES_USER=artisan
POSTGRES_PASSWORD=artisan_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=artisan_commerce
DATABASE_URL=postgresql+asyncpg://artisan:artisan_dev_password@localhost:5432/artisan_commerce

# Redis (Caching & Session Store)
REDIS_URL=redis://localhost:6379/0

# MinIO / S3 Object Storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=artisan-media
S3_USE_SSL=false

# JWT Authentication
JWT_SECRET=dev-jwt-secret-key-artisan-commerce-2026-secure
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# SMS OTP Authentication (2Factor.in & Dev Mock)
OTP_PROVIDER=2factor
OTP_EXPIRY_SECONDS=300
TWOFACTOR_API_KEY=your_2factor_api_key_here
TWOFACTOR_TEMPLATE_NAME=VENDOKART_OTP
DEV_MOCK_OTP=123456

# CORS Allowed Origins (JSON array or comma-separated URLs)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# AI / Semantic Search & Gemini RAG
# Get Gemini API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
USE_TRANSFORMERS_MODEL=0

# Local LLM Support (Optional)
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b

# External Integrations (Optional)
GOOGLE_MAPS_API_KEY=
WHATSAPP_API_URL=
WHATSAPP_ACCESS_TOKEN=
SENTRY_DSN=
