# Environment Variables Specification
APP_ENV=development
APP_NAME=artisan-commerce
SECRET_KEY=dev-super-secret-key-change-in-production-1234567890
API_V1_STR=/api/v1

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=artisan_commerce

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO / S3 Storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=artisan-media
S3_USE_SSL=false

# JWT Security
JWT_SECRET=dev-jwt-secret-key-artisan-commerce-2026-secure
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Phone OTP
OTP_PROVIDER=dev_mock
OTP_API_KEY=
OTP_EXPIRY_SECONDS=300
DEV_MOCK_OTP=123456

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# LLM / AI Configuration (Placeholder for Stage 3+)
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b

# External APIs (Optional)
GOOGLE_MAPS_API_KEY=
WHATSAPP_API_URL=
WHATSAPP_ACCESS_TOKEN=
SENTRY_DSN=
