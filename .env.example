# Environment Variables Specification Example
APP_ENV=development
APP_NAME=artisan-commerce
SECRET_KEY=dev-super-secret-key-change-in-production-1234567890
API_V1_STR=/api/v1

# PostgreSQL Database
POSTGRES_USER=artisan
POSTGRES_PASSWORD=artisan_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=artisan_commerce
DATABASE_URL=postgresql+asyncpg://artisan:artisan_dev_password@localhost:5432/artisan_commerce

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO / S3 Storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=artisan-media
S3_USE_SSL=false

# JWT Security
JWT_SECRET=dev-jwt-secret-key-artisan-commerce-2026-secure
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Phone OTP & 2Factor.in SMS Gateway
OTP_PROVIDER=2factor
OTP_EXPIRY_SECONDS=300
DEV_MOCK_OTP=123456

# 2Factor.in Live API Key
TWOFACTOR_API_KEY=your-2factor-api-key-here
TWOFACTOR_TEMPLATE_NAME=VENDOKART_OTP

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# LLM / AI Configuration (Local / Ollama)
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b

# External APIs (Optional)
GOOGLE_MAPS_API_KEY=
WHATSAPP_API_URL=
WHATSAPP_ACCESS_TOKEN=
SENTRY_DSN=

# Groq AI Keys & Model Architecture
GROQ_API_KEY_20B=your-groq-api-key-20b-here
GROQ_API_KEY_120B=your-groq-api-key-120b-here
GROQ_API_KEY=your-groq-api-key-here

MODEL_PRICING_EXPLANATION=openai/gpt-oss-20b
MODEL_NEGOTIATION_AGENT=openai/gpt-oss-120b
MODEL_SUSPICIOUS_DATA_REASONING=openai/gpt-oss-20b
MODEL_VOICE_STT=whisper-large-v3-turbo
MODEL_MARKET_INFO=groq/compound
